<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/time" xmlns:tns="http://www.iese.fraunhofer.de/ind2uce/3.0.25/time"
  elementFormDefault="qualified">

  <complexType name="MechanismTimestepType">
    <attribute name="amount" type="long" use="required" />
    <attribute name="unit" type="tns:MechanismTimeUnitType" use="required"/>
  </complexType>

  <complexType name="OperatorTimestepType">
    <attribute name="amount" type="long" use="required" />
    <attribute name="unit" type="tns:OperatorTimeUnitType" use="optional" default="TIMESTEPS" />
  </complexType>

  <simpleType name="MechanismTimeUnitType">
    <restriction base="string">
      <enumeration value="MILLISECONDS" />
      <enumeration value="SECONDS" />
      <enumeration value="MINUTES" />
      <enumeration value="HOURS" />
      <enumeration value="DAYS" />
      <enumeration value="WEEKS" />
      <enumeration value="MONTHS" />
      <enumeration value="YEARS" />
    </restriction>
  </simpleType>

  <simpleType name="OperatorTimeUnitType">
    <restriction base="string">
      <enumeration value="TIMESTEPS" />
      <enumeration value="MILLISECONDS" />
      <enumeration value="SECONDS" />
      <enumeration value="MINUTES" />
      <enumeration value="HOURS" />
      <enumeration value="DAYS" />
      <enumeration value="WEEKS" />
      <enumeration value="MONTHS" />
      <enumeration value="YEARS" />
    </restriction>
  </simpleType>

</schema>

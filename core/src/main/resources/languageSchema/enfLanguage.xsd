<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/enforcementLanguage" xmlns:tns="http://www.iese.fraunhofer.de/ind2uce/3.0.25/enforcementLanguage"
  xmlns:time="http://www.iese.fraunhofer.de/ind2uce/3.0.25/time" xmlns:action="http://www.iese.fraunhofer.de/ind2uce/3.0.25/action" xmlns:event="http://www.iese.fraunhofer.de/ind2uce/3.0.25/event"

  xmlns:param="http://www.iese.fraunhofer.de/ind2uce/3.0.25/param" xmlns:function="http://www.iese.fraunhofer.de/ind2uce/3.0.25/function" xmlns:pip="http://www.iese.fraunhofer.de/ind2uce/3.0.25/pip"

  elementFormDefault="qualified">

  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/time" schemaLocation="time.xsd" />
  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/action" schemaLocation="action.xsd" />
  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/event" schemaLocation="event.xsd" />

  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/function" schemaLocation="ind2uceFunction.xsd" />
  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/param" schemaLocation="ind2uceParam.xsd" />
  <import namespace="http://www.iese.fraunhofer.de/ind2uce/3.0.25/pip" schemaLocation="ind2ucePIP.xsd" />

  <complexType name="TrueType" />

  <complexType name="FalseType" />

  <complexType name="NotOperatorType">
    <group ref="tns:OperatorsGroup" minOccurs="1" maxOccurs="1" />
  </complexType>

  <complexType name="AndOperatorType">
    <group ref="tns:OperatorsGroup" minOccurs="1" maxOccurs="unbounded" />
  </complexType>

  <complexType name="OrOperatorType">
    <group ref="tns:OperatorsGroup" minOccurs="1" maxOccurs="unbounded" />
  </complexType>

  <complexType name="ImpliesOperatorType">
    <group ref="tns:OperatorsGroup" minOccurs="2" maxOccurs="2" />
  </complexType>

  <group name="OperatorsGroup">
    <annotation>
      <documentation>Propositional, pip and event operators
      </documentation>
    </annotation>
    <choice>
      <element name="true" type="tns:TrueType" />
      <element name="false" type="tns:FalseType" />
      <element ref="pip:boolean" />
      <element ref="param:boolean" />
      <group ref="function:BooleanFunctionGroup" />
      <element name="not" type="tns:NotOperatorType" />
      <element name="and" type="tns:AndOperatorType" />
      <element name="or" type="tns:OrOperatorType" />
      <element name="implies" type="tns:ImpliesOperatorType" />
    </choice>
  </group>

  <complexType name="ModifyActionType">
    <sequence>
      <element ref="param:event" minOccurs="1" maxOccurs="unbounded" />
    </sequence>
  </complexType>

  <complexType name="AuthorizationInhibitType">
    <sequence>
      <element name="delay" type="time:OperatorTimestepType" minOccurs="0" maxOccurs="1" />
    </sequence>
  </complexType>

  <complexType name="AuthorizationAllowType">
    <sequence>
      <element name="delay" type="time:OperatorTimestepType" minOccurs="0" maxOccurs="1" />
      <element name="modify" type="tns:ModifyActionType" minOccurs="0" maxOccurs="1" />
      <element name="executeAction" type="action:ExecuteActionType" minOccurs="0" maxOccurs="unbounded" />
    </sequence>
  </complexType>

  <complexType name="AuthorizationDecisionType">
    <sequence>
      <choice minOccurs="1" maxOccurs="1">
        <element name="allow" type="tns:AuthorizationAllowType" />
        <element name="inhibit" type="tns:AuthorizationInhibitType" />
      </choice>
      <element name="executeAction" type="action:ExecuteActionType" minOccurs="0" maxOccurs="unbounded" />
    </sequence>
    <attribute name="name" type="ID" use="optional" />
    <attribute name="fallback" type="IDREF" use="optional" />
  </complexType>
  
  <complexType name="AuthorizationDecisionFallbackType">
    <sequence>
      <choice minOccurs="1" maxOccurs="1">
        <element name="allow" type="tns:AuthorizationAllowType" />
        <element name="inhibit" type="tns:AuthorizationInhibitType" />
      </choice>
      <element name="executeAction" type="action:ExecuteActionType" minOccurs="0" maxOccurs="unbounded" />
    </sequence>
    <attribute name="name" type="ID" use="required" />
    <attribute name="fallback" type="IDREF" use="optional" />
  </complexType>

  <complexType name="ConditionType">
    <group ref="tns:OperatorsGroup" />
  </complexType>

  <complexType name="DetectiveMechanismType">
    <sequence>
      <element name="description" type="string" minOccurs="0" maxOccurs="1" />
      <choice minOccurs="1" maxOccurs="2">
        <element name="timestep" type="time:MechanismTimestepType" minOccurs="0" maxOccurs="1" />
        <element name="event" type="event:EventMatchingOperatorType" minOccurs="0" maxOccurs="1" />
      </choice>
      <element name="condition" type="tns:ConditionType" />
      <element name="executeAction" type="action:ExecuteActionType" minOccurs="1" maxOccurs="unbounded" />
    </sequence>
    <attribute name="id" type="ID" use="optional" />
  </complexType>

  <complexType name="PreventiveMechanismType">
    <sequence>
      <element name="description" type="string" minOccurs="0" maxOccurs="1" />
      <element name="timestep" type="time:MechanismTimestepType" minOccurs="0" maxOccurs="1" />
      <element name="event" type="event:EventMatchingOperatorType" />
      <element name="condition" type="tns:ConditionType" />
      <element name="authorizationDecision" type="tns:AuthorizationDecisionType" />
      <element name="fallbackAuthorizationDecision" type="tns:AuthorizationDecisionFallbackType" minOccurs="0" maxOccurs="unbounded" />
      <element name="executeAction" type="action:ExecuteActionType" minOccurs="0" maxOccurs="unbounded" />
    </sequence>
    <attribute name="id" type="ID" use="optional" />
  </complexType>

  <complexType name="PolicyType">
    <sequence>
      <choice minOccurs="1" maxOccurs="unbounded">
        <element name="detectiveMechanism" type="tns:DetectiveMechanismType" />
        <element name="preventiveMechanism" type="tns:PreventiveMechanismType" />
      </choice>
    </sequence>
    <attribute name="id" use="required">
      <simpleType>
        <restriction base="string">
            <pattern value="urn:policy:[a-z0-9\-_\.]+:[a-zA-Z0-9\-_\.]+"></pattern>
        </restriction>
      </simpleType>
    </attribute>
    <attribute name="description" type="string" use="required" />
  </complexType>

  <element name="policy" type="tns:PolicyType" />

</schema>

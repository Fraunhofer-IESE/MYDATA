<policy id='urn:policy:mydata-solution:sdfdsf' xmlns='http://www.iese.fraunhofer.de/ind2uce/3.2.46/ind2uceLanguage'
        xmlns:constant='http://www.iese.fraunhofer.de/ind2uce/3.2.46/constant'>
    <mechanism event='urn:action:mydata-solution:enforceBankData'>
        <if>
            <equals>
                <count>
                    <eventOccurrence event='urn:action:mydata-solution:enforceBankData'/>
                    <when>
                        <start time='*.*.* *:*:*'>
                            <eventOccurrence event='urn:action:andere-solution:enforceBankData' mode='FIRST'/>
                        </start>
                        <end time='*.*.* *:*:*'/>
                    </when>
                </count>
                <constant:number value='5'/>
            </equals>
            <then>
                <inhibit/>
            </then>
        </if>
    </mechanism>
</policy>

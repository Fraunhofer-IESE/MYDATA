<policy id='urn:policy:test:preventive-policyInhibitWithObjectComparision' description=''
        xmlns='http://www.mydata-control.de/4.0/mydataLanguage'
        xmlns:constant='http://www.mydata-control.de/4.0/constant'
        xmlns:event="http://www.mydata-control.de/4.0/event">

    <mechanism id='prevAllowExecuteInAllow' event="urn:action:test:showEmployee">
        <if>
            <equals>
                <event:object eventParameter='user' jsonPathQuery='$.name' default=""/>
                <constant:object value='{"firstName":"John","lastName":"doe"}'/>
            </equals>
            <then>
                <inhibit/>
            </then>
        </if>
    </mechanism>
</policy>
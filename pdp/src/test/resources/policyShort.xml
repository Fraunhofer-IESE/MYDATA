<?xml version="1.0" encoding="UTF-8"?>
<policy
        xmlns="http://www.mydata-control.de/4.0/mydataLanguage"
        xmlns:event="http://www.mydata-control.de/4.0/event"
        xmlns:constant="http://www.mydata-control.de/4.0/constant"
        xmlns:parameter="http://www.mydata-control.de/4.0/parameter"
        xmlns:variable="http://www.mydata-control.de/4.0/variable"
        xmlns:variableDeclaration="http://www.mydata-control.de/4.0/variableDeclaration"
        id="urn:policy:test:b" description="Policy for Fleet PoC Use Case 1">

    <variableDeclaration:string name="content_of_superstring">
        <event:string eventParameter="superString" default="1" />
    </variableDeclaration:string>

    <mechanism id="decideOnStorageOfPositionUpdates"
               description="Decides whether to store a position update coming from a vehicle."
               event="urn:action:test:cr-writeData">

        <if>
            <and>
                <equals>
                    <event:boolean eventParameter="eventType" default="false"/>
                    <constant:true></constant:true>
                </equals>
                <eventHasParameter>
                    <constant:string value="attribute/longitude"/>
                </eventHasParameter>
            </and>
            <then>
                <modify eventParameter="latitude" method="delete">

                    <parameter:string  name="superString">
                        <variable:string reference="content_of_superstring"/>
                    </parameter:string>
                </modify>
            </then>
        </if>
    </mechanism>
</policy>